{
  "sap.app": {
    "id": "inventory.optimization",
    "type": "application",
    "i18n": "./i18n.properties",
    "version": "1.0.0",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": {
      "@sap.ui.component": "#component.js"
    },
    "applicationType": "singleSplitAppWithNavigationSet",
    "shellIntegrationEnabled": true,
    "businessUnitId": "",
    "manifest_version": "1.54"
  },
  "sap.ui.generic.app": {
    "versioningStrategy": "V2_0",
    "dataSources": {
      "_defaultDataSource": {
        "dataSourceName": "InventoryDataService"
      }
    },
    "settings": {
      "dynamicPageHeaderSettings": true,
      "shellIntegrationSettings": {}
    },
    "entitySets": [
      {
        "name": "InventoryOverview",
        "path": "/inventoryStatuses",
        "type": "Collection"
      }
    ],
    "_versionInfo_2.0": [],
    "smartFiltersConfig": {}
  },
  "@sap.ui5": {
    "modelDefinitions": {},
    "dependencies": {
      "minUI5Version": "1.76.0",
      "libs": {
        "@sap/generic-apps-fiori-elements-v2-templates": "^1.3"
      }
    },
    "contentDensificationSettings": {}
  }
}
